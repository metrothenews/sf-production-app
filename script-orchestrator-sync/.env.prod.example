# Required
CONTROL_SHEET_ID=PUT_CONTROL_SHEET_ID_HERE

# Gateway
SHEETS_JSON_BASE_URL=https://YOUR-SHEETS-JSON-GATEWAY.a.run.app
SHEETS_JSON_API_KEY=

# Runtime
APP_PORT=8000
BLENDER_VERSION=4.2.2
REQUIRE_RENDER_BINARIES=1

# Render execution backend (`local` for in-container subprocess, `batch` for Cloud Batch)
RENDER_EXEC_BACKEND=batch

# Cloud Batch (required when RENDER_EXEC_BACKEND=batch)
GCP_PROJECT_ID=
GCP_REGION=us-east1
BATCH_IMAGE_URI=
BATCH_JOB_QUEUE=render-default
BATCH_MACHINE_TYPE=n2d-standard-8
BATCH_SERVICE_ACCOUNT_EMAIL=so-render-batch@<project-id>.iam.gserviceaccount.com
BATCH_MAX_RETRIES=1
BATCH_TIMEOUT_SECONDS=14400
BATCH_TASK_CPU_MILLI=8000
BATCH_TASK_MEMORY_MIB=32768

# Secret materialization for render worker credential file
DRIVE_SA_KEY_SECRET_NAME=so-drive-sa-key-json
# Set by Cloud Run/Secret Manager binding in production:
DRIVE_SA_KEY_JSON=
DRIVE_SA_KEY_FILE=/secrets/drive-sa.json

# Auth option A (recommended on GCE): leave empty and use VM attached service account
GOOGLE_APPLICATION_CREDENTIALS=

# Auth option B (key file): put JSON at ./secrets/google-application-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-application-credentials.json
