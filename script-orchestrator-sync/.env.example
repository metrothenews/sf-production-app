# Gateway
SHEETS_JSON_BASE_URL=https://YOUR-SHEETS-JSON-GATEWAY.a.run.app
SHEETS_JSON_API_KEY=PUT_KEY_HERE

# Sheets
SHEET_INTAKE=YOUR_GOOGLE_SHEET_ID
INTAKE_TAB=Sheet2
INTAKE_ROW=2

SHEET_PROD=YOUR_GOOGLE_SHEET_ID
PROD_TAB=SO Campaigns
TARGET_CAMPAIGN_ID=demo_campaign_001

# Control + sync
CONTROL_SHEET_ID=PUT_CONTROL_SHEET_ID_HERE
# Optional override. If unset, runner auto-selects the single enabled job in Sync_Jobs.
JOB_ID=

# Set to 1 to enable writes
APPLY=0
DRY_RUN=1

# Render/runtime overrides (optional)
# BLENDER_BIN=blender
# VSE_STITCHER_SCRIPT_PATH=/workspace/vse-stitcher/scripts/vse_bpm_preset_deterministic_bl456.py
# VSE_TEXT_SCRIPT_PATH=/workspace/vse-text/scripts/vse_bpm_preset_deterministic_bl456.py
# GOOGLE_APPLICATION_CREDENTIALS=/workspace/.config/gcloud/application_default_credentials.json
