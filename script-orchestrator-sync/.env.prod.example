# Required
CONTROL_SHEET_ID=PUT_CONTROL_SHEET_ID_HERE

# Optional VM batch-worker overrides now live in .env.vm (see .env.vm.example).

# Gateway
SHEETS_JSON_BASE_URL=https://YOUR-SHEETS-JSON-GATEWAY.a.run.app
SHEETS_JSON_API_KEY=

# Runtime
APP_PORT=8000
BLENDER_VERSION=4.2.2
REQUIRE_RENDER_BINARIES=1
# Clip library source (`drive` or `gcs_mirror`).
# Recommended for cloud cost control: set to gcs_mirror after running library_mirror_refresh.
CLIPS_LIBRARY_SOURCE=drive
CLIPS_LIBRARY_MIRROR_BUCKET=
CLIPS_LIBRARY_MIRROR_PREFIX=library-mirror
# Optional explicit index object override:
# CLIPS_LIBRARY_MIRROR_INDEX_OBJECT=library-mirror/indexes/library_mirror_index.json
# Optional quarantine manifest override:
# CLIPS_LIBRARY_MIRROR_QUARANTINE_MANIFEST_OBJECT=library-mirror/indexes/quarantine_manifest.json
# Mirror freshness warning threshold (hours) for compile in gcs_mirror mode.
CLIPS_LIBRARY_MIRROR_WARN_STALE_HOURS=24
# Quarantine retention before purge (days) for library-mirror-refresh.
CLIPS_LIBRARY_MIRROR_QUARANTINE_TTL_DAYS=7
# pipeline_v1 mode switch: keep per-cut render enabled (required in current build)
PIPELINE_PER_CUT_RENDER=1
# Two-pass effects pipeline: stitch(base-only) -> effects -> lyrics/copy
PIPELINE_EFFECTS_PASS2_ENABLED=1
PIPELINE_EFFECTS_PASS2_STRICT=1
PIPELINE_EFFECTS_PASS2_KEEP_PLAN_ON_SUCCESS=0
PIPELINE_EFFECTS_BASE_FRAME_SLACK=1

# Deep observability + diagnostics
PIPELINE_OBSERVABILITY_MODE=deep
PIPELINE_JSON_EVENTS_ENABLED=1
PIPELINE_STAGE_HEARTBEAT_SECONDS=20
PIPELINE_STAGE_TIMEOUT_SECONDS=0
PIPELINE_FORENSICS_ON_FAILURE=1
PIPELINE_FORENSICS_FRAME_SAMPLES=12
PIPELINE_FORENSICS_UPLOAD=1

# Render execution backend (`local` for in-container subprocess, `batch` for Cloud Batch)
RENDER_EXEC_BACKEND=batch

# Cloud Batch (required when RENDER_EXEC_BACKEND=batch)
GCP_PROJECT_ID=
GCP_REGION=us-east1
BATCH_IMAGE_URI=
BATCH_JOB_QUEUE=render-default
BATCH_MACHINE_TYPE=n2d-standard-8
BATCH_SERVICE_ACCOUNT_EMAIL=so-render-batch@<project-id>.iam.gserviceaccount.com
# Required when Batch worker uses attached SA (no key JSON): include Drive scope.
BATCH_SERVICE_ACCOUNT_SCOPES=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/drive
BATCH_MAX_RETRIES=1
BATCH_TIMEOUT_SECONDS=14400
BATCH_TASK_CPU_MILLI=8000
BATCH_TASK_MEMORY_MIB=32768

# Secret materialization for render worker credential file
DRIVE_SA_KEY_SECRET_NAME=so-drive-sa-key-json
# Set by Cloud Run/Secret Manager binding in production:
DRIVE_SA_KEY_JSON=
DRIVE_SA_KEY_FILE=/secrets/drive-sa.json

# Auth option A (recommended on GCE): leave empty and use VM attached service account
GOOGLE_APPLICATION_CREDENTIALS=

# Auth option B (key file): put JSON at ./secrets/google-application-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-application-credentials.json
