# VM container batch-worker overrides
# This file is optional and layered after .env.prod when using docker-compose.vm-batch.yml.

# Render locally in the containerized VM worker (not Cloud Batch).
RENDER_EXEC_BACKEND=local

# Optional clip source override for per-cut clip downloads.
# CLIPS_LIBRARY_SOURCE=gcs_mirror
# CLIPS_LIBRARY_MIRROR_BUCKET=your-bucket-name
# CLIPS_LIBRARY_MIRROR_PREFIX=library-mirror
# CLIPS_LIBRARY_MIRROR_INDEX_OBJECT=library-mirror/indexes/library_mirror_index.json
# CLIPS_LIBRARY_MIRROR_WARN_STALE_HOURS=24
# CLIPS_LIBRARY_MIRROR_QUARANTINE_TTL_DAYS=7

# Batch worker loop behavior
BATCH_LOOP_INTERVAL_SECONDS=20
BATCH_LOOP_EXIT_ON_ERROR=0
BATCH_LOOP_ONCE=0

# Optional stale lease recovery while looping
AUTO_RECOVER_STALE_ACTIVE_JOBS=1
RENDER_ACTIVE_STALE_SECONDS=1800

# Optional auth override for key-file mode
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-application-credentials.json
